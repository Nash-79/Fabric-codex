# Local secrets — copy to `.env.local` and fill in. NEVER put these in `.env`, which is tracked
# in git (it deliberately holds only the public VITE_SUPABASE_* build-time values).
#
# Every script loads `.env.local` first and then `.env`, so anything set here wins.

# The deployed app. Local scripts POST to it for anything needing privileged database access,
# because the service-role key is server-only and managed by Lovable Cloud.
FABRIC_ATLAS_APP_URL=https://fabric-atlas.lovable.app

# Shared bearer token for the agent hooks. Must match FABRIC_ATLAS_AGENT_READ_TOKEN configured on
# the server, or every call returns 401. Used by:
#   scripts/check-queues.mjs        (read queue/watcher state)
#   scripts/poll-watchers.mjs       (read watcher state)
#   scripts/generate-embeddings.mjs (write claim embeddings)
FABRIC_ATLAS_AGENT_READ_TOKEN=

# Optional. Only needed if you deliberately want a local script to write Supabase directly,
# bypassing the app. Normally leave this unset: the whole point of the hook route is that this
# key never has to leave the server.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional embedding overrides (defaults shown). The dimension is fixed by the vector(768) column
# type, so changing the model means changing the migration and re-running with --force.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
# EMBED_CONCURRENCY=6
