#!/bin/sh

# Opt-in guard: only prune when explicitly enabled by the developer.
if [ "$(git config --bool --get hooks.pruneMergedBranches)" != "true" ]; then
  exit 0
fi

# Delete local branches that are already merged into HEAD, except the
# current branch and default branch names.
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
remote_name="$(git config --get "branch.$current_branch.remote" 2>/dev/null || echo '')"

if [ -z "$remote_name" ]; then
  if git remote get-url origin >/dev/null 2>&1; then
    remote_name="origin"
  else
    remote_name="$(git remote | head -n 1)"
  fi
fi

if [ -n "$remote_name" ]; then
  git fetch --prune --quiet "$remote_name" >/dev/null 2>&1 || true
fi

default_branch=""
if [ -n "$remote_name" ]; then
  remote_head_ref="$(git symbolic-ref --quiet --short "refs/remotes/$remote_name/HEAD" 2>/dev/null || echo '')"
  case "$remote_head_ref" in
    "$remote_name"/*)
      default_branch="${remote_head_ref#"$remote_name/"}"
      ;;
  esac
fi

if [ -z "$default_branch" ] && [ -n "$remote_name" ]; then
  default_branch="$(git remote show -n "$remote_name" 2>/dev/null | sed -n 's/^[[:space:]]*HEAD branch: //p' | head -n 1)"
fi

git for-each-ref refs/heads --merged HEAD --format='%(refname:short)' | while IFS= read -r branch; do
  [ -z "$branch" ] && continue
  [ "$branch" = "$current_branch" ] && continue
  [ "$branch" = "$default_branch" ] && continue

  case "$branch" in
    main|master)
      continue
      ;;
  esac

  upstream_ref="$(git rev-parse --symbolic-full-name --verify "$branch@{upstream}" 2>/dev/null || echo '')"
  case "$upstream_ref" in
    refs/remotes/*)
      if git show-ref --verify --quiet "$upstream_ref"; then
        continue
      fi
      ;;
  esac

  git branch -d "$branch"
done
