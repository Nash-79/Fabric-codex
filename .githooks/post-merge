#!/bin/sh

# Opt-in guard: only prune when explicitly enabled by the developer.
if [ "$(git config --bool --get hooks.pruneMergedBranches)" != "true" ]; then
  exit 0
fi

# Delete local branches that are already merged into HEAD, except the
# current branch and default branch names.
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"

if git remote get-url origin >/dev/null 2>&1; then
  git fetch --prune --quiet origin >/dev/null 2>&1 || true
fi

default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"

if [ -z "$default_branch" ]; then
  default_branch="$(git remote show -n origin 2>/dev/null | sed -n 's/^[[:space:]]*HEAD branch: //p' | head -n 1)"
fi

git for-each-ref refs/heads --merged HEAD --format='%(refname:short)' | while IFS= read -r branch; do
  [ -z "$branch" ] && continue
  [ "$branch" = "$current_branch" ] && continue
  [ "$branch" = "$default_branch" ] && continue

  case "$branch" in
    main|master)
      continue
      ;;
  esac

  upstream="$(git for-each-ref --format='%(upstream:short)' "refs/heads/$branch")"
  if [ -n "$upstream" ] && git show-ref --verify --quiet "refs/remotes/$upstream"; then
    continue
  fi

  git branch -d "$branch"
done
