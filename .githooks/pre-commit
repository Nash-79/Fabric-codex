#!/bin/sh
# If package.json is part of this commit, regenerate package-lock.json and
# stage it too, so `npm ci` in CI can never see the two files out of sync.
if git diff --cached --name-only | grep -qx "package.json"; then
  echo "pre-commit: package.json staged — syncing package-lock.json"
  npm install --package-lock-only --no-audit --no-fund || exit 1
  git add package-lock.json
fi
