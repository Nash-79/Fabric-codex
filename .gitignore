# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# db / local
*.db
# .env intentionally committed (public VITE_SUPABASE_* values needed at build time).
# .env.local is NOT: it is where local secrets go (FABRIC_ATLAS_AGENT_READ_TOKEN, an optional
# SUPABASE_SERVICE_ROLE_KEY). Every script loads .env.local first, then .env, so a value set
# there overrides the committed one. Never put a secret in .env -- it is tracked.
.env.local
.env.*.local

# derived retrieval index (rebuild with scripts/build_index.py)
var/
*.duckdb

# node / frontend
node_modules/
dist/
.vite/
.tanstack/
.output/
.wrangler/

# editorial baseline screenshots (Phase 1 of the Editorial Experience Revamp) -- the
# baseline/summary.json and baseline/content-metrics.json manifests ARE committed for
# later-phase comparison; only the PNGs are excluded to keep the repo lean.
baseline/*.png

# editors / os
.vscode/
.idea/
.DS_Store
bun.lock
