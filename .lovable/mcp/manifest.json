{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ysgmvtvwrkrxagefkhrc.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "fabric-atlas-mcp",
      "version": "0.1.0",
      "title": "Fabric Atlas MCP"
    },
    "tools": [
      {
        "name": "list_capabilities",
        "title": "List Fabric capabilities",
        "description": "List every Microsoft Fabric capability in the Fabric Atlas registry (id, name, description, accent).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_topics",
        "title": "List Fabric topics",
        "description": "List every topic node in the Fabric Atlas taxonomy (slug, name, parent, capability associations).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_claims",
        "title": "Get source-cited claims",
        "description": "Return source-cited claims from the Fabric Atlas knowledge base, optionally filtered by capability id, depth (1-5), trust tier (1-6), or a free-text query.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "capabilityId": {
              "description": "Capability id, e.g. 'direct-lake', 'onelake', 'spark'.",
              "type": "string"
            },
            "depth": {
              "description": "Depth level 1-5.",
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "tier": {
              "description": "Trust tier 1 (best) - 6 (unknown).",
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "q": {
              "description": "Free-text search over claim text.",
              "type": "string"
            },
            "limit": {
              "description": "Max claims to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_atlas",
        "title": "Search Fabric Atlas",
        "description": "Full-text search across Fabric Atlas topics, claims, sources, articles, designs, and lessons.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "description": "Search query."
            }
          },
          "required": ["q"]
        },
        "outputSchema": null
      },
      {
        "name": "get_article",
        "title": "Get Fabric Atlas article",
        "description": "Fetch the full body (markdown), summary, and cited sources for one Fabric Atlas content item (article, design, or lesson).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["article", "design", "lesson"],
              "description": "Content kind."
            },
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Content item slug."
            }
          },
          "required": ["kind", "slug"]
        },
        "outputSchema": null
      }
    ]
  }
}
