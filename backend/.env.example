# LLM-backed steps (ingestion extraction, design generation, grounding/coverage validators)
# need this. Deterministic steps (versioning, citation + freshness validators) run without it.
ANTHROPIC_API_KEY=

# Any current Anthropic model id. Sonnet is a good default for extraction/validation;
# use an Opus model if you want stronger architecture generation.
ANTHROPIC_MODEL=claude-sonnet-4-6

# SQLite by default — zero infra, survives restarts. For scale, point at Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fabric_atlas
DATABASE_URL=sqlite:///./fabric_atlas.db

# Comma-separated origins allowed to call the API (the React frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
