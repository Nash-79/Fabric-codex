# LLM-backed steps (ingestion extraction, design generation, grounding/coverage validators,
# advisor chat) need this. Deterministic steps (versioning, citation + freshness validators)
# run without it.
ANTHROPIC_API_KEY=

# Any current Anthropic model id. Sonnet is a good default for extraction/validation/advisor;
# use an Opus model if you want stronger architecture generation.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase Postgres. Use the connection-pooler URL from the Supabase dashboard
# (Project Settings -> Database -> Connection string -> URI), with the +psycopg driver.
# The backend connects as the service role and owns all writes (versioning/validation).
# Example:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Comma-separated origins allowed to call the API (the React frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
