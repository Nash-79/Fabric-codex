{
  // Owned Cloudflare Workers config for Fabric Codex.
  //
  // Nitro's cloudflare-module preset also emits a wrangler.json into .output/server/, but that
  // file is regenerated on every build and cannot be relied on:
  //   - it derives the Worker name from the git remote (nash-79-fabric-codex), not package.json,
  //     and renaming a deployed Worker changes its URL;
  //   - it stamps compatibility_date with TODAY's date, so the runtime semantics would silently
  //     drift with every rebuild.
  // This file pins both. `npm run deploy` points wrangler here explicitly.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fabric-codex",

  // Pinned deliberately. Raise it only as a considered change -- it selects Workers runtime
  // semantics, and a moving date means a moving target.
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],

  // Nitro emits the server bundle here and pre-bundles it, so wrangler must not re-bundle.
  "main": ".output/server/index.mjs",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],

  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },

  "observability": {
    "enabled": true
  },

  // Workers AI. 10,000 neurons/day are included free, which is the point of putting it at the
  // top of the provider chain. The binding is what makes `env.AI` available in the Worker; the
  // provider also works via the account REST endpoint, so local `vite dev` (no binding) still
  // functions with a Cloudflare account id + API token configured in Settings.
  "ai": {
    "binding": "AI"
  }

  // Size headroom, measured 2026-09-06 via `wrangler deploy --dry-run`:
  //   Total Upload 32.7 MiB against a 64 MiB uncompressed limit (all plans since 2026-09-04,
  //   when the old 3 MB-compressed / 10 MB-compressed caps were withdrawn). The `gzip` figure
  //   wrangler also prints is informational only and is NOT what is enforced.
  //   Static assets: 830 files (limit 20,000), largest 1.2 MiB (limit 25 MiB each).
  //
  // What grows, and what does not:
  //   - ARTICLES do not count. Bodies live in Supabase (content_items.body_md) and are fetched
  //     at request time; their images land in .output/public, which is static assets and is
  //     limited separately (20,000 files / 25 MiB each), not by the 64 MiB Worker size.
  //   - DIAGRAMS do count: each is compiled into the server bundle for SSR at ~90 KiB
  //     (305 _ssr modules for 103 diagrams -- the SVG plus its .diagram.json sidecar).
  //     29 MiB free therefore allows roughly 320 more diagrams. Roughly 25 MiB of the bundle is
  //     fixed framework/dependency code independent of content.
  //   If that ceiling is ever approached, serve diagrams as STATIC ASSETS instead of bundling
  //   them (already mirrored to public/diagrams/ and hash-registered in
  //   content/diagrams/assets.json). That moves them off the Worker size limit, keeps them on
  //   Cloudflare's edge, and preserves the static_hash integrity check.
  //
  //   Do NOT move them into Supabase Storage. They are already lazy-loaded -- catalog.ts uses
  //   import.meta.glob WITHOUT `eager`, so each diagram is its own code-split chunk and a page
  //   loads only what it renders. The 9 MiB is deploy-time shelf space, not runtime payload.
  //   Fetching from Supabase would instead add a Worker->Frankfurt round trip on the critical
  //   render path, spend the 50-subrequest-per-invocation budget, make diagrams independently
  //   fail-able, and drop the hash guarantee on the bytes actually rendered. Supabase's storage
  //   quota is not the constraint here; Worker bundle size is.

  // Bindings added in later Phase 2 steps, once each is provisioned:
  //   "ai": { "binding": "AI" }                        -- Workers AI (Phase 3)
  //   "r2_buckets": [...]                              -- file storage (Phase 2.3)
  //
  // Secrets are NOT declared here. SUPABASE_SERVICE_ROLE_KEY and the Supabase URL/publishable
  // key are set as Worker secrets / environment variables in the Cloudflare dashboard, so no
  // credential lands in the repo.
}
